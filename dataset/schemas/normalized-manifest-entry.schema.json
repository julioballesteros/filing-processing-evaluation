{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized reference manifest entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "filing_id",
    "path",
    "sha256",
    "schema_version",
    "status",
    "reviewed_at",
    "reviewed_by"
  ],
  "properties": {
    "filing_id": { "type": "string", "pattern": "^sec-[0-9]{10}-[0-9]{2}-[0-9]{6}$" },
    "path": { "type": "string", "pattern": "^normalized/.+\\.json$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "schema_version": { "const": "1.2.0" },
    "status": { "enum": ["draft", "reviewed"] },
    "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
    "reviewed_by": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "draft" } } },
      "then": {
        "properties": {
          "reviewed_at": { "type": "null" },
          "reviewed_by": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "reviewed" } } },
      "then": {
        "properties": {
          "reviewed_at": { "type": "string", "format": "date-time" },
          "reviewed_by": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
