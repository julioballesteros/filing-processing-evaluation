{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Filing manifest entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "filing_id",
    "regulator",
    "provider",
    "company_name",
    "cik",
    "ticker",
    "sector",
    "form_type",
    "is_amendment",
    "filing_date",
    "period_end_date",
    "accession_number",
    "primary_document",
    "source_url",
    "raw_path"
  ],
  "properties": {
    "filing_id": { "type": "string", "pattern": "^sec-[0-9]{10}-[0-9]{2}-[0-9]{6}$" },
    "regulator": { "const": "sec" },
    "provider": { "const": "sec-edgar" },
    "company_name": { "type": "string", "minLength": 1 },
    "cik": { "type": "string", "pattern": "^[0-9]{10}$" },
    "ticker": { "type": "string", "minLength": 1 },
    "sector": { "type": "string", "minLength": 1 },
    "form_type": { "enum": ["10-K", "10-Q"] },
    "is_amendment": { "const": false },
    "filing_date": { "type": "string", "format": "date" },
    "period_end_date": { "type": "string", "format": "date" },
    "accession_number": { "type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$" },
    "primary_document": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri", "pattern": "^https://www\\.sec\\.gov/Archives/" },
    "raw_path": { "type": "string", "pattern": "^raw/" }
  }
}
