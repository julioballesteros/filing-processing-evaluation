{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Filing manifest entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "filing_id",
    "regulator",
    "provider",
    "company_name",
    "cik",
    "ticker",
    "sector",
    "form_type",
    "is_amendment",
    "filing_date",
    "period_end_date",
    "accession_number",
    "primary_document",
    "source_url",
    "raw_path"
  ],
  "properties": {
    "filing_id": { "type": "string", "pattern": "^sec-[0-9]{10}-[0-9]{2}-[0-9]{6}$" },
    "regulator": { "const": "sec" },
    "provider": { "const": "sec-edgar" },
    "company_name": { "type": "string", "minLength": 1 },
    "cik": { "type": "string", "pattern": "^[0-9]{10}$" },
    "ticker": { "type": "string", "minLength": 1 },
    "sector": { "type": "string", "minLength": 1 },
    "form_type": { "enum": ["10-K", "10-Q", "8-K"] },
    "is_amendment": { "const": false },
    "filing_date": { "type": "string", "format": "date" },
    "period_end_date": { "type": "string", "format": "date" },
    "accession_number": { "type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$" },
    "primary_document": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri", "pattern": "^https://www\\.sec\\.gov/Archives/" },
    "raw_path": { "type": "string", "pattern": "^raw/" },
    "event_date": { "type": "string", "format": "date" },
    "items": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "exhibits": {
      "type": "array",
      "items": { "$ref": "#/$defs/rawExhibit" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "form_type": { "const": "8-K" } } },
      "then": {
        "required": ["event_date", "items", "exhibits"],
        "properties": {
          "items": { "contains": { "const": "2.02" } },
          "exhibits": {
            "minItems": 1,
            "contains": {
              "properties": { "artifact_id": { "const": "earnings-release" } },
              "required": ["artifact_id"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "rawExhibit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sequence",
        "document_type",
        "description",
        "filename",
        "media_type",
        "source_url",
        "raw_path"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "not": { "const": "primary" }
        },
        "sequence": { "type": "integer", "minimum": 2 },
        "document_type": { "type": "string", "pattern": "^EX-" },
        "description": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "pattern": "^[^/]+$" },
        "media_type": {
          "enum": ["text/html", "application/xhtml+xml"]
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://www\\.sec\\.gov/Archives/"
        },
        "raw_path": { "type": "string", "pattern": "^raw/" }
      }
    }
  }
}
