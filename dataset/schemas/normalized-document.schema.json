{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical normalized filing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "filing_id",
    "raw_sha256",
    "document",
    "sections",
    "blocks"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "filing_id": { "type": "string", "minLength": 1 },
    "raw_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "language"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 }
      }
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/heading" },
          { "$ref": "#/$defs/paragraph" },
          { "$ref": "#/$defs/listItem" },
          { "$ref": "#/$defs/table" },
          { "$ref": "#/$defs/pageBreak" }
        ]
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "parent_id",
        "level",
        "label",
        "title",
        "heading_block_id"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^s[0-9]{4,}$" },
        "order": { "type": "integer", "minimum": 1 },
        "parent_id": { "type": ["string", "null"] },
        "level": { "type": "integer", "minimum": 1 },
        "label": { "type": "string", "minLength": 1 },
        "title": { "type": ["string", "null"] },
        "heading_block_id": { "type": "string", "pattern": "^b[0-9]{4,}$" }
      }
    },
    "commonBlock": {
      "type": "object",
      "required": ["id", "order", "section_id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^b[0-9]{4,}$" },
        "order": { "type": "integer", "minimum": 1 },
        "section_id": { "type": ["string", "null"] },
        "type": { "type": "string" }
      }
    },
    "heading": {
      "allOf": [
        { "$ref": "#/$defs/commonBlock" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "order", "section_id", "type", "level", "text"],
          "properties": {
            "id": true,
            "order": true,
            "section_id": true,
            "type": { "const": "heading" },
            "level": { "type": "integer", "minimum": 1, "maximum": 6 },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "paragraph": {
      "allOf": [
        { "$ref": "#/$defs/commonBlock" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "order", "section_id", "type", "text"],
          "properties": {
            "id": true,
            "order": true,
            "section_id": true,
            "type": { "const": "paragraph" },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "listItem": {
      "allOf": [
        { "$ref": "#/$defs/commonBlock" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "order", "section_id", "type", "text"],
          "properties": {
            "id": true,
            "order": true,
            "section_id": true,
            "type": { "const": "list_item" },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "pageBreak": {
      "allOf": [
        { "$ref": "#/$defs/commonBlock" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "order", "section_id", "type"],
          "properties": {
            "id": true,
            "order": true,
            "section_id": true,
            "type": { "const": "page_break" }
          }
        }
      ]
    },
    "table": {
      "allOf": [
        { "$ref": "#/$defs/commonBlock" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "order",
            "section_id",
            "type",
            "caption",
            "row_count",
            "column_count",
            "cells"
          ],
          "properties": {
            "id": true,
            "order": true,
            "section_id": true,
            "type": { "const": "table" },
            "caption": { "type": ["string", "null"] },
            "row_count": { "type": "integer", "minimum": 1 },
            "column_count": { "type": "integer", "minimum": 1 },
            "cells": {
              "type": "array",
              "items": { "$ref": "#/$defs/cell" }
            }
          }
        }
      ]
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row",
        "column",
        "row_span",
        "column_span",
        "role",
        "text"
      ],
      "properties": {
        "row": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 },
        "row_span": { "type": "integer", "minimum": 1 },
        "column_span": { "type": "integer", "minimum": 1 },
        "role": { "enum": ["header", "data"] },
        "text": { "type": "string" }
      }
    }
  }
}
