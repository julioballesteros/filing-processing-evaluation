{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical normalized filing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "filing_id",
    "raw_sha256",
    "document",
    "page_count",
    "sections",
    "blocks"
  ],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "filing_id": { "type": "string", "minLength": 1 },
    "raw_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "source_title",
        "language",
        "company_name",
        "form_type",
        "filing_date",
        "period_end_date"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "source_title": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "company_name": { "type": "string", "minLength": 1 },
        "form_type": { "enum": ["10-K", "10-Q"] },
        "filing_date": { "type": "string", "format": "date" },
        "period_end_date": { "type": "string", "format": "date" }
      }
    },
    "page_count": { "type": "integer", "minimum": 1 },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/heading" },
          { "$ref": "#/$defs/paragraph" },
          { "$ref": "#/$defs/listItem" },
          { "$ref": "#/$defs/table" }
        ]
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "parent_id",
        "level",
        "label",
        "title",
        "heading_block_id"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^s[0-9]{4,}$" },
        "order": { "type": "integer", "minimum": 1 },
        "parent_id": { "type": ["string", "null"] },
        "level": { "type": "integer", "minimum": 1 },
        "label": { "type": "string", "minLength": 1 },
        "title": { "type": ["string", "null"] },
        "heading_block_id": { "type": "string", "pattern": "^b[0-9]{4,}$" }
      }
    },
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_number", "path"],
      "properties": {
        "page_number": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "pattern": "^/html/body\\[1\\]/" }
      }
    },
    "commonBlock": {
      "type": "object",
      "required": ["id", "order", "section_id", "type", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^b[0-9]{4,}$" },
        "order": { "type": "integer", "minimum": 1 },
        "section_id": { "type": ["string", "null"] },
        "type": { "type": "string" },
        "source": { "$ref": "#/$defs/sourceLocator" }
      }
    },
    "heading": {
      "allOf": [
        { "$ref": "#/$defs/commonBlock" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "order",
            "section_id",
            "type",
            "source",
            "level",
            "text"
          ],
          "properties": {
            "id": true,
            "order": true,
            "section_id": true,
            "type": { "const": "heading" },
            "source": true,
            "level": { "type": "integer", "minimum": 1, "maximum": 6 },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "paragraph": {
      "allOf": [
        { "$ref": "#/$defs/commonBlock" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "order", "section_id", "type", "source", "text"],
          "properties": {
            "id": true,
            "order": true,
            "section_id": true,
            "type": { "const": "paragraph" },
            "source": true,
            "text": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "listItem": {
      "allOf": [
        { "$ref": "#/$defs/commonBlock" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "order", "section_id", "type", "source", "text"],
          "properties": {
            "id": true,
            "order": true,
            "section_id": true,
            "type": { "const": "list_item" },
            "source": true,
            "text": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "table": {
      "allOf": [
        { "$ref": "#/$defs/commonBlock" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "order",
            "section_id",
            "type",
            "source",
            "caption",
            "row_count",
            "column_count",
            "source_shape",
            "cells"
          ],
          "properties": {
            "id": true,
            "order": true,
            "section_id": true,
            "type": { "const": "table" },
            "source": true,
            "caption": { "type": ["string", "null"] },
            "row_count": { "type": "integer", "minimum": 1 },
            "column_count": { "type": "integer", "minimum": 1 },
            "source_shape": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rows", "columns"],
              "properties": {
                "rows": { "type": "integer", "minimum": 1 },
                "columns": { "type": "integer", "minimum": 1 }
              }
            },
            "cells": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/cell" }
            }
          }
        }
      ]
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row",
        "column",
        "row_span",
        "column_span",
        "text",
        "source_cells",
        "role"
      ],
      "properties": {
        "row": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 },
        "row_span": { "type": "integer", "minimum": 1 },
        "column_span": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 },
        "source_cells": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceCell" }
        },
        "role": { "enum": ["header", "row_header", "data"] }
      }
    },
    "sourceCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "column", "row_span", "column_span"],
      "properties": {
        "row": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 },
        "row_span": { "type": "integer", "minimum": 1 },
        "column_span": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
